{
  "name": "konvertoj",
  "version": "1.0.0",
  "description": "Convert and edit images, PDFs, video and audio locally and privately from the command line.",
  "keywords": [
    "convert",
    "converter",
    "image",
    "heic",
    "jpg",
    "png",
    "webp",
    "avif",
    "pdf",
    "gif",
    "mp4",
    "mp3",
    "compress",
    "resize",
    "cli",
    "local",
    "private",
    "offline"
  ],
  "license": "MIT",
  "author": "Zubs <zubairidrisaweda@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zubs/konvertoj.git"
  },
  "homepage": "https://github.com/Zubs/konvertoj#readme",
  "bugs": {
    "url": "https://github.com/Zubs/konvertoj/issues"
  },
  "type": "module",
  "bin": {
    "konvertoj": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "docs": "npm run build && node scripts/update-readme.js",
    "demo": "npm run build && vhs docs/demo.tape"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "bmp-ts": "^1.0.9",
    "decode-ico": "^0.4.1",
    "exifr": "^7.1.3",
    "fast-glob": "^3.3.3",
    "file-type": "^22.2.0",
    "heic-decode": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
